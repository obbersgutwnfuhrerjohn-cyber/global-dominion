PORT=3000
HOST=0.0.0.0
TICK_MS=10000
DATA_DIR=./data
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-game-domain.example

# Google Play server verification
GOOGLE_PACKAGE_NAME=com.globaldominion.game
# Base64-encoded Google service-account JSON with androidpublisher scope access
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Apple App Store Server API verification
APPLE_BUNDLE_ID=com.globaldominion.game
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
# Base64-encoded Apple Root CA certificates, comma-separated.
APPLE_ROOT_CERTIFICATES_BASE64=
APPLE_APP_ID=
APPLE_ENVIRONMENT=production

# Development-only purchase testing. MUST remain 0/unset in production.
ALLOW_TEST_IAP=0
