{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_ALLOW_DEMO": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_ALLOW_DEMO": "0",
        "EXPO_PUBLIC_API_URL": "https://staging-api.globaldominion.game/api",
        "EXPO_PUBLIC_WS_URL": "wss://staging-api.globaldominion.game/ws"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_ALLOW_DEMO": "0",
        "EXPO_PUBLIC_API_URL": "https://api.globaldominion.game/api",
        "EXPO_PUBLIC_WS_URL": "wss://api.globaldominion.game/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
