{
  "expo": {
    "name": "Global Dominion",
    "slug": "global-dominion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "globaldominion",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.globaldominion.game",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.globaldominion.game",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C"
      },
      "permissions": [
        "com.android.vending.BILLING",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
