# Local / Codespaces
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_ALLOW_DEMO=1
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_WS_URL=ws://localhost:3000/ws

# Production (replace with the Render service URL)
# EXPO_PUBLIC_ENV=production
# EXPO_PUBLIC_ALLOW_DEMO=0
# EXPO_PUBLIC_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api
# EXPO_PUBLIC_WS_URL=wss://YOUR-RENDER-SERVICE.onrender.com/ws
